# ── Frontend environment variables (Vite) ─────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# All variables must be prefixed with VITE_ to be exposed to the browser.

# URL of your deployed API server (Vercel serverless function or local dev).
# In dev this is proxied by Vite, so you usually don't need to set it.
# VITE_API_URL=https://your-api.vercel.app

# URL of the voice signaling server (Render / Railway persistent WebSocket host).
# Without this, voice chat falls back to window.location.origin (won't work on Vercel).
# Get this from your Render dashboard after deploying render.yaml.
VITE_VOICE_SIGNALING_URL=https://studyworks-voice-deployment.onrender.com

# Metered Open Relay TURN credentials (free 20 GB/month).
# Sign up at https://dashboard.metered.ca/signup → TURN Servers → Credentials.
# Without these, voice still works on home/mobile networks (STUN only).
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Admin dashboard access.
# Set this to your own email address. When signed in with this email,
# an "🛡️ Admin" link appears in the sidebar giving access to the admin
# dashboard where you can upgrade/downgrade any user's tier.
# Must match the ADMIN_EMAIL variable set on the server (.env / Vercel env vars).
VITE_ADMIN_EMAIL=your@email.com
