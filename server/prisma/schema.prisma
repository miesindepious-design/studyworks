// StudyWorks Prisma schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth (Better Auth tables) ─────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tier          Tier     @default(FREE)

  // 7-day free Pro trial — started automatically on the user's first login.
  trialStartsAt DateTime?
  trialEndsAt   DateTime?

  // Student profile (collected at signup; drives AI tutor difficulty/syllabus)
  schoolStage    String? // "primary" | "secondary" | "university"
  schoolClass    String? // exact class, e.g. "Primary 5", "JSS 2", "SS 3", "Grade 7"
  universityYear String? // exact year, e.g. "Year 1" .. "Year 5", "Postgraduate"
  department     String? // university department, e.g. "Computer Science", "Medicine & Surgery"

  // AI Tutor: education level for adaptive lesson complexity
  educationLevel String? // "high-school" | "college-freshman" | "college-sophomore" | "college-junior" | "college-senior" | "university" | "graduate" | "phd"
  stripeCustomerId       String? @unique
  stripeSubscriptionId   String? @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  sessions      Session[]
  accounts      Account[]

  notes             Note[]
  contacts          Contact[]
  flashcards        Flashcard[]
  folders           Folder[]
  practiceQuestions PracticeQuestion[]
  savedSearches     SavedSearch[]
  aiSettings        AISettings?

  // Phase 2
  streak            Streak?
  folderShares      FolderShare[]
  supportTickets    SupportTicket[]
  inboundEmailToken InboundEmailToken?

  // Phase 3: multiplayer quiz
  gameRooms   GameRoom[]
  gamePlayers GamePlayer[]

  // Phase 4: lobby
  lobbies     Lobby[]
  lobbyVisits LobbyParticipant[]

  // Weekly email digest — opt-in, off by default. Nobody gets mail they
  // did not ask for. `digestDay` is 0 = Sunday … 6 = Saturday.
  digestEnabled    Boolean   @default(false)
  digestDay        Int       @default(1)
  // When the last digest went out, so a retried run never double-sends.
  digestLastSentAt DateTime?

  // Phase 6: shared study files dropped into a lobby
  roomFiles   RoomFile[]

  // Phase 5: progression (XP, quests, achievements, season)
  progress   UserProgress?
  gameRating GameRating?
  examPlans  ExamPlan[]
  assignments Assignment[]

  // Phase 5: matches (live results + asynchronous duels)
  matchesAsChallenger GameMatch[] @relation("MatchChallenger")
  matchesAsOpponent   GameMatch[] @relation("MatchOpponent")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ── Subscription tier ─────────────────────────────────────────────────────────
enum Tier {
  FREE
  PRO
}

// ── AI Settings ───────────────────────────────────────────────────────────────
model AISettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  provider             String  @default("gemini")
  model                String  @default("gemini-2.5-flash")
  enabled              Boolean @default(false)
  encryptedApiKey      String? // stored encrypted server-side
  customSummaryPrompt  String?
  customFlashcardPrompt String?
  customQAPrompt       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Notes ─────────────────────────────────────────────────────────────────────
model Note {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String   @db.Text
  type        String   @default("note") // note | article | idea | project
  tags        String[] @default([])
  summary     String?  @db.Text
  folderId    String?
  nextReminder DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Spaced-repetition state. A note that is never reviewed is a note the
  // student forgets, so notes are scheduled on the same SM-2 curve as cards
  // and practice questions.
  repetitions  Int      @default(0)
  interval     Int      @default(0)
  ef           Float    @default(2.5)
  nextReview   DateTime?
  reviewHistory Json?
  leechCount   Int      @default(0)

  user      User      @relation(fields: [userId],  references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  highlights    Highlight[]
  personalNotes PersonalNote[]
  attachments   Attachment[]

  @@index([userId])
  @@index([userId, folderId])
  @@index([userId, type])
}

model Highlight {
  id        String   @id @default(cuid())
  noteId    String
  text      String
  color     String
  note      String?  // optional user annotation attached to the highlight
  createdAt DateTime @default(now())

  note_rel Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  @@index([noteId])
}

model PersonalNote {
  id        String   @id @default(cuid())
  noteId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  @@index([noteId])
}

model Attachment {
  id         String   @id @default(cuid())
  noteId     String
  name       String
  type       String   // pdf | image | audio
  storageKey String   // S3/R2 object key
  url        String   // presigned or public URL
  size       Int
  uploadedAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  @@index([noteId])
}

// ── Contacts ──────────────────────────────────────────────────────────────────
model Contact {
  id           String    @id @default(cuid())
  userId       String
  name         String
  role         String
  email        String?
  phone        String?
  notes        String?   @db.Text
  tags         String[]  @default([])
  folderId     String?
  nextReminder DateTime?
  lastContacted DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User    @relation(fields: [userId],   references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ── Flashcards ────────────────────────────────────────────────────────────────
model Flashcard {
  id          String    @id @default(cuid())
  userId      String
  question    String    @db.Text
  answer      String    @db.Text
  tags        String[]  @default([])
  folderId    String?
  difficulty  String?   // easy | medium | hard
  nextReview  DateTime?
  interval    Int?
  repetitions Int?
  ef          Float?    // SM-2 easiness factor; defaults to 2.5 if unset
  // Card shape. "fill-in" hides the answer behind an input; "cloze" hides a
  // marked span inside the question itself.
  type        String    @default("standard") // standard | fill-in | cloze
  // The subject this card belongs to, used by the Mastery Map. Free text so it
  // can be anything the student calls a topic ("Photosynthesis", "Year 2 Maths").
  topic       String?
  // How many times this card has been rated "Again". Three or more makes it a
  // leech: the card is broken, not the student.
  leechCount  Int       @default(0)
  // Where the card came from, so the app can offer to fix AI-generated ones.
  source      String?   // manual | note | ai | tutor
  // [{ date: 'YYYY-MM-DD', quality: 0-3 }] — the review trail shown on a card.
  reviewHistory Json?
  // When an AI rewrite of this card was accepted. A card that has been fixed
  // is not offered the fixer again — otherwise a single stubborn leech could
  // burn AI calls (and farm the leech_fixed XP) forever.
  fixedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User    @relation(fields: [userId],   references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, nextReview])
  @@index([userId, topic])
}

// ── Practice Questions ────────────────────────────────────────────────────────
model PracticeQuestion {
  id       String   @id @default(cuid())
  userId   String
  question String   @db.Text
  answer   String   @db.Text
  type     String   // multiple-choice | true-false | open
  options  String[] @default([])
  noteId   String?
  topic    String?  // subject, for the Mastery Map

  // Spaced-repetition state. Same shape as Flashcard so a single SM-2
  // implementation can drive both. The first version of the schema didn't
  // have these; existing rows will see `null` and the client treats that
  // as "due immediately" (nextReview: undefined → falls to the front of
  // the queue).
  nextReview          DateTime?
  interval            Int?
  repetitions         Int?
  ef                  Float?
  lastAnsweredCorrect Boolean?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, nextReview])
}

// ── Folders ───────────────────────────────────────────────────────────────────
model Folder {
  id          String  @id @default(cuid())
  userId      String
  name        String
  isSmart     Boolean @default(false)
  smartFilter String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]
  contacts  Contact[]
  flashcards Flashcard[]

  @@index([userId])
}

// ── Saved Searches ────────────────────────────────────────────────────────────
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ── Phase 2: Streaks (cross-device) ───────────────────────────────────────────
// One row per user. Client merges local IDB streak with this on sync:
// counts are summed per-day (max wins per day), streak recomputed.
model Streak {
  id             String   @id @default(cuid())
  userId         String   @unique
  lastReviewDate String?  // YYYY-MM-DD
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  totalReviews   Int      @default(0)
  dailyCounts    Json     @default("{}") // { "2026-07-25": 14, ... } pruned to 90d
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Phase 2: Folder sharing ───────────────────────────────────────────────────
// Read-only share links: /shared/:token shows the folder's notes.
model FolderShare {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid()) // unguessable URL token
  folderId  String
  userId    String    // owner
  createdAt DateTime  @default(now())
  expiresAt DateTime? // null = never expires
  revoked   Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([folderId])
  @@index([userId])
}

// ── Phase 2: Support inbox ────────────────────────────────────────────────────
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  body      String
  status    String   @default("open") // open | replied | closed
  reply     String?  // support's reply (single-thread for now)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([status])
}

// ── Phase 2: Email-to-save ────────────────────────────────────────────────────
// Each user gets a secret inbound address token: save-<token>@inbound.domain.
// The mail provider (Resend/Mailgun/Cloudflare Email Routing) POSTs parsed
// emails to /api/inbound-email; we look up the token and create a note.
// ── Phase 3: Multiplayer quiz (real-time, room-code based) ────────────────────
// A GameRoom is created by a host, joined via a shareable code. Questions come
// from the host's flashcards or an AI-generated topic. Players answer in real
// time over WebSocket; XP = base × speed bonus (faster answer = more XP).
model GameRoom {
  id          String   @id @default(cuid())
  code        String   @unique @default(cuid()) // short shareable code (we shorten in app)
  hostId      String
  status      String   @default("lobby") // lobby | live | finished
  source      String   @default("flashcards") // flashcards | topic
  topic       String?  // when source === 'topic'
  questionIds String[] // ordered GameQuestion ids
  settings    Json?    // { perQuestionSec, baseXp }
  createdAt   DateTime @default(now())

  host     User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  players  GamePlayer[]
  questions GameQuestion[]
  answers  GameAnswer[]
  @@index([hostId])
}

model GamePlayer {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  name      String
  xp        Int      @default(0)
  joinedAt  DateTime @default(now())

  room  GameRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers GameAnswer[]
  @@unique([roomId, userId])
  @@index([roomId])
}

model GameQuestion {
  id        String   @id @default(cuid())
  roomId    String
  // Snapshot of the question so the game is self-contained (doesn't depend on
  // the host's live flashcard data after creation).
  prompt    String
  options   String[] // answer choices (shuffled at creation)
  answerIdx Int      // index into options of the correct answer
  order     Int      // position in the round

  room     GameRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  answers  GameAnswer[]
  @@index([roomId])
}

model GameAnswer {
  id          String   @id @default(cuid())
  roomId      String
  questionId  String
  playerId    String
  choiceIdx   Int?     // null = timed out / no answer
  correct     Boolean  @default(false)
  responseMs  Int?     // time taken to answer (null = timeout)
  xpAwarded   Int      @default(0)
  answeredAt  DateTime @default(now())

  room     GameRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  question GameQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  player   GamePlayer    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@index([roomId])
  @@index([playerId])
}

// ── Phase 4: Lobby (the shareable front door to a live session) ───────────────
// Every quiz room and study room gets a Lobby. The lobby owns the six-digit
// code that people actually share; it points at the real session so a player
// who only has the code (or the link, or the QR) can be routed to the right
// kind of session — a live quiz or a study room — without knowing how that
// session is implemented.
//
// kind === 'quiz'  → targetCode is the GameRoom.code to join
// kind === 'study' → targetCode is the voice room id, targetUrl the Daily URL
model Lobby {
  id              String   @id @default(cuid())
  code            String   @unique // six-digit numeric join code
  kind            String   // quiz | study
  title           String
  hostId          String
  targetCode      String?  // quiz: GameRoom.code · study: voice room id
  targetUrl       String?  // study: the Daily room URL (null in local mode)
  maxParticipants Int      @default(6)
  status          String   @default("open") // open | live | closed
  createdAt       DateTime @default(now())
  expiresAt       DateTime?
  // When this lobby was last actually used. A study group that exists only
  // to hold material has no roster to go by — nobody "joins" it — so this is
  // what tells the sweep whether the group is still in use.
  lastActivityAt  DateTime @default(now())

  host         User               @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants LobbyParticipant[]
  roomFiles    RoomFile[]
  @@index([hostId])
  @@index([kind])
}

// ── Phase 4: Lobby presence ───────────────────────────────────────────────────
// Who is actually in a lobby right now. Study sessions need this to answer
// three questions the client can't answer on its own: who is here, who is
// the host, and has everybody left. A participant is "active" while they
// keep heartbeating (the lobby state poll touches lastSeenAt) and has not
// explicitly left; the host is whoever is hosting right now — the original
// creator until they leave, then the earliest-joined active participant.
model LobbyParticipant {
  id         String    @id @default(cuid())
  lobbyId    String
  userId     String
  joinedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  leftAt     DateTime?

  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, userId])
  @@index([lobbyId])
  @@index([userId])
}

// ── Phase 6: Shared study files (the group's material in the lobby) ──────────
// A file a member of the study group drops into the lobby so the whole group
// can study from the same material: the textbook chapter, the past paper, the
// slides. The lobby code is the invitation, so a file belongs to the lobby —
// not to one person's note.
//
// `text` holds the extracted plain text of the file. It is what the AI reads
// to ground a lesson, build a quiz battle or set a duel, which is why the
// client extracts it in the browser (pdfjs / jszip / OCR are already there)
// and posts it alongside the metadata. It is null when a file was uploaded
// but could not be read.
model RoomFile {
  id         String   @id @default(cuid())
  lobbyId    String
  uploaderId String
  name       String
  type       String   @default("other") // pdf | docx | pptx | image | html | text | other
  size       Int      @default(0)
  // Object storage key and public URL, when R2 is configured.
  storageKey String?
  url        String?
  // Extracted plain text — the AI grounding material.
  text       String?  @db.Text
  createdAt  DateTime @default(now())

  lobby    Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([lobbyId])
  @@index([uploaderId])
}

// ── Phase 2: Email-to-save ────────────────────────────────────────────────────
// Each user gets a secret inbound address token: save-<token>@inbound.domain.
// The mail provider (Resend/Mailgun/Cloudflare Email Routing) POSTs parsed
// emails to /api/inbound-email; we look up the token and create a note.
model InboundEmailToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Phase 5: Progression ──────────────────────────────────────────────────────
// One row per user. XP, level, the streak-freeze wallet, the season score and
// the set of unlocked achievements live here so progress follows the student
// across devices instead of dying with the browser's localStorage.
//
// The quest state is stored as JSON because the quest definitions change with
// the season: the server rebuilds today's quests from the rule set and only
// keeps the *progress* the student made.
model UserProgress {
  id        String   @id @default(cuid())
  userId    String   @unique
  xp        Int      @default(0)
  level     Int      @default(1)
  seasonXp  Int      @default(0)
  // Streak freezes: earned by hitting a quest streak, spent to cover a missed
  // day without losing the streak.
  streakFreezes Int @default(1)
  // Completed focus sessions — the "focus forest" grows one tree per session.
  focusTrees Int      @default(0)
  unlockedAchievements String[] @default([])
  // Progress on today's quests: { "<questId>": 7 }
  questState Json     @default("{}")
  // The day the quest progress belongs to (YYYY-MM-DD). Stale days are reset.
  questDate  String?
  // XP totals per day for the last 30 days, for the weekly recap.
  dailyXp    Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Phase 5: Quiz rating (ELO) ───────────────────────────────────────────────
// Competitive rating for quiz battles and asynchronous duels. Everyone starts
// at BASE_RATING so a new student is never punished for being new.
model GameRating {
  id         String   @id @default(cuid())
  userId     String   @unique
  rating     Int      @default(1200)
  peakRating Int      @default(1200)
  games      Int      @default(0)
  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Phase 5: Matches (live results and asynchronous duels) ───────────────────
// A match records one head-to-head contest. Live battles write their result
// here when the game ends (the WebSocket host may be a separate deployment,
// so the client reports the outcome over REST). Asynchronous duels use the
// same row: the challenger is scored immediately, the opponent answers later
// and the row is completed when both sides have played.
model GameMatch {
  id              String   @id @default(cuid())
  code            String   @unique @default(cuid()) // shareable duel code
  mode            String   @default("live") // live | async
  source          String   @default("flashcards") // flashcards | topic
  topic           String?
  challengerId    String
  challengerName  String
  opponentId      String?
  opponentName    String?
  status          String   @default("open") // open | completed | expired
  // Snapshot of the questions so a duel can be replayed later.
  questions       Json
  challengerScore Int?
  opponentScore   Int?
  winnerId        String?
  ratingBefore    Float?
  ratingAfter     Float?
  opponentRatingBefore Float?
  opponentRatingAfter  Float?
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?

  challenger User  @relation("MatchChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User? @relation("MatchOpponent",  fields: [opponentId],   references: [id], onDelete: SetNull)

  @@index([challengerId])
  @@index([opponentId])
  @@index([status])
}

// ── Phase 5: Exam plans ───────────────────────────────────────────────────────
// "My biology exam is in 12 days" → the planner back-calculates how many
// cards a day have to be reviewed to be ready, and shows the countdown.
model ExamPlan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  examDate    DateTime
  subjects    String[] @default([])
  dailyTarget Int      @default(20)
  notes       String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ── Grade tracker ─────────────────────────────────────────────────────────────
// A student needs one number that means something: where they stand, and
// what they must score on the rest to hit their target. That only works if
// the weights are honest — a 1% quiz and a 99% final are not the same
// thing — so each assignment carries the share of the course grade it is
// worth, and the maths happens on the client.
model Assignment {
  id        String   @id @default(cuid())
  userId    String
  title     String
  course    String   @default("General")
  category  String   @default("Assignment") // Homework | Quiz | Exam | Project | Lab
  // Percentage points of the final course grade this is worth.
  weight    Float    @default(0)
  // The mark received. Null means it has not been marked yet.
  score     Float?
  // The mark it is out of.
  maxScore  Float    @default(100)
  dueDate   DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, course])
}
