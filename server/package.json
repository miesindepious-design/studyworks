{
  "name": "studyworks-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "voice": "tsx watch src/voiceServer.ts",
    "voice:build": "tsc -p tsconfig.voice.json",
    "voice:start": "node dist-voice/voiceServer.js",
    "keepalive": "tsx src/keepalive.ts",
    "keepalive:build": "tsc -p tsconfig.voice.json",
    "keepalive:start": "node dist-voice/keepalive.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@hono/node-server": "^1.14.3",
    "@hono/zod-validator": "^0.4.3",
    "@prisma/client": "^6.6.0",
    "better-auth": "^1.2.7",
    "dotenv": "^16.4.7",
    "hono": "^4.12.32",
    "resend": "^4.5.1",
    "socket.io": "^4.8.1",
    "stripe": "^17.7.0",
    "tsx": "^4.19.3",
    "typescript": "~5.6.2",
    "ws": "^8.21.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/socket.io": "^3.0.0",
    "@types/ws": "^8.18.1",
    "prisma": "^6.6.0",
    "vitest": "^2.1.8"
  }
}
