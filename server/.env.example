# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local:      postgresql://user:password@localhost:5432/studyworks
# Neon/Supabase/Railway: copy the connection string from the dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/studyworks"

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:3001"

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_YEARLY_PRICE_ID="price_..."

# ── Resend (email) ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="StudyWorks <noreply@yourdomain.com>"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── R2 / S3 Object Storage (Pro feature — file attachments) ───────────────────
# Cloudflare R2 (S3-compatible). Create a bucket + access key in the
# Cloudflare dashboard, then paste the credentials here.
# If unset, file uploads fall back to the legacy base64-in-IDB path so dev
# still works without R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="studyworks-attachments"
# Optional. If set, uploaded files are served from this base URL
# (typically a public R2 bucket or a custom domain with R2).
R2_PUBLIC_BASE_URL=""

# ── Google OAuth (optional) ─────────────────────────────────────────────────────
# Create OAuth credentials: https://console.cloud.google.com/apis/credentials
#   1. Create Project (or reuse one) → OAuth consent screen → External → add your email as test user
#   2. Credentials → Create Credentials → OAuth client ID → Web application
#   3. Authorized JavaScript origins:
#        Dev:  http://localhost:5173
#        Prod: https://<YOUR_FRONTEND_URL>
#   4. Authorized redirect URIs:
#        Dev:  http://localhost:3001/auth/callback/google
#        Prod: https://<YOUR_BACKEND_URL>/auth/callback/google
# Leave blank to disable Google sign-in (email/password still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Backend Key (optional) ──────────────────────────────────────────────────
# If set, all Pro users get AI features without entering their own key.
# The key is stored server-side only and never exposed to clients.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=  # rotate: old key was committed here — set fresh key only in hosting env vars
# ── Tavily Web Search (optional — powers the tutor's web research) ──
# Free plan: 1 000 credits/month, no credit card required.
# Sign up at https://app.tavily.com  → API Keys → Create key
# When set, the AI Tutor can search the web when it needs recent or
# specific information.  When unset, the tutor answers from the model's
# own knowledge only.
TAVILY_API_KEY=

# ── AI Key Pool (optional) ─────────────────────────────────────────────────────
# Several server-managed keys, used as one pool: when a key's project runs
# out of free-tier quota for the day — or the model is simply overloaded —
# the next key answers instead and the feature keeps working.
#
# Use ONE KEY PER GOOGLE CLOUD PROJECT. Free-tier quota is counted per
# project, so keys that share a project share one quota and gain you
# nothing. Separate projects = separate quota = that much more room.
#
# Comma, space or newline separated. AI_API_KEY above is still honoured and
# is added to the pool, so you can migrate without changing anything else.
# AI_API_KEYS=key-one,key-two,key-three
#
# Let a user's own key be covered by the pool when it fails in a way
# another key could survive. Set to 0 to keep the pool strictly server-side.
AI_POOL_FALLBACK=1

# Models to try when every key has failed for the current one.
#
# A second key does not help when the model itself is out of capacity for
# everyone — that is model-side, not key-side. Dropping to a different
# model does. List free-tier models that can answer the same request:
#   AI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
# Leave empty to disable model fallback.

# ── Admin bootstrap ─────────────────────────────────────────────────────────────
# Optional: if set, signing in with this Google email auto-upgrades to PRO.
ADMIN_EMAIL=

# ── Voice chat signaling (optional) ───────────────────────────────────────────
# Leave unset to use the same server host/port for Socket.IO voice signaling.
# Set this if you deploy voice signaling to a separate Node host, e.g.:
# VOICE_SIGNALING_URL=https://voice-studyworks.example.com
VOICE_SIGNALING_URL=

# ── Voice TURN server credentials (frontend env vars — set on Vercel) ──────────
# Sign up free at https://dashboard.metered.ca/signup
# Then: TURN Servers → Credentials → copy username + credential
# Set these in Vercel: Settings → Environment Variables
#   VITE_TURN_USERNAME=<your-metered-username>
#   VITE_TURN_CREDENTIAL=<your-metered-credential>
# Without these, voice still works for home/mobile networks (STUN only).
# TURN is needed for corporate Wi-Fi / symmetric-NAT environments.
