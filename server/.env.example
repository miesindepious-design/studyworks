# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local:      postgresql://user:password@localhost:5432/studyworks
# Neon/Supabase/Railway: copy the connection string from the dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/studyworks"

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:3001"

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_YEARLY_PRICE_ID="price_..."

# ── Resend (email) ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="StudyWorks <noreply@yourdomain.com>"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── R2 / S3 Object Storage (Pro feature — file attachments) ───────────────────
# Cloudflare R2 (S3-compatible). Create a bucket + access key in the
# Cloudflare dashboard, then paste the credentials here.
# If unset, file uploads fall back to the legacy base64-in-IDB path so dev
# still works without R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="studyworks-attachments"
# Optional. If set, uploaded files are served from this base URL
# (typically a public R2 bucket or a custom domain with R2).
R2_PUBLIC_BASE_URL=""

# ── Google OAuth (optional) ─────────────────────────────────────────────────────
# Create OAuth credentials: https://console.cloud.google.com/apis/credentials
#   1. Create Project (or reuse one) → OAuth consent screen → External → add your email as test user
#   2. Credentials → Create Credentials → OAuth client ID → Web application
#   3. Authorized JavaScript origins:
#        Dev:  http://localhost:5173
#        Prod: https://<YOUR_FRONTEND_URL>
#   4. Authorized redirect URIs:
#        Dev:  http://localhost:3001/auth/callback/google
#        Prod: https://<YOUR_BACKEND_URL>/auth/callback/google
# Leave blank to disable Google sign-in (email/password still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin bootstrap ─────────────────────────────────────────────────────────────
# Optional: if set, signing in with this Google email auto-upgrades to PRO.
ADMIN_EMAIL=
