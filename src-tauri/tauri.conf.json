{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyWorks",
  "version": "0.2.0",
  "identifier": "com.studyworks.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "StudyWorks",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "MCowBQYDK2VwAyEAmPnKwOQfPOxoMQj8IuoK6PWLWQxPThPehFLpDebJrWk=",
      "endpoints": [
        "https://raw.githubusercontent.com/miesindepious-design/studyworks/master/releases/latest.json"
      ],
      "dialog": false,
      "gracePeriodMs": 1000
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["studyworks"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": null
    }
  }
}
