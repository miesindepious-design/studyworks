{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyWorks",
  "version": "0.2.1",
  "identifier": "com.studyworks.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StudyWorks",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https://studyworks-seven.vercel.app; connect-src 'self' tauri: https://studyworks-seven.vercel.app wss://studyworks-seven.vercel.app https://*.vercel.app; img-src 'self' tauri: data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGN0UwRjgxRTZEMUU3MkUKUldRdTU5SG1nUTErLzFFTHRML1ZLVHQ4RHQ3NXVTSEhKK1BZd2xvS2ttMWZrcWxIQkNmNWZxcGsK",
      "endpoints": [
        "https://studyworks-seven.vercel.app/api/releases/latest"
      ],
      "dialog": false,
      "gracePeriodMs": 1000
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["studyworks"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": null
    }
  }
}
