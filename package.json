{
  "name": "studyworks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:voice": "npm run voice --prefix server",
    "dev:all": "concurrently -n client,server,voice -c blue,green,magenta \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:voice\"",
    "build": "vite build",
    "build:all": "npm run build && npm run build --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:generate": "npm run db:generate --prefix server",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "db:studio": "npm run db:studio --prefix server",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@hono/node-server": "^1.14.3",
    "@hono/zod-validator": "^0.4.3",
    "@prisma/client": "^6.6.0",
    "better-auth": "^1.2.7",
    "dotenv": "^16.4.7",
    "hono": "^4.7.11",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "prisma": "^6.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.5.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "stripe": "^17.7.0",
    "tesseract.js": "^7.0.0",
    "trystero": "^0.26.0",
    "ws": "^8.21.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
  }
}
