{
  "name": "studyworks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:voice": "npm run voice --prefix server",
    "dev:all": "concurrently -n client,server,voice -c blue,green,magenta \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:voice\"",
    "build": "vite build",
    "build:all": "npm run build && npm run build --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:generate": "npm run db:generate --prefix server",
    "db:studio": "npm run db:studio --prefix server",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "hono": "^4.7.11",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
  }
}
